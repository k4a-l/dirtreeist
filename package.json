{
	"name": "@k4a_l/dirtreeist",
	"version": "1.0.0",
	"main": "./dist/index.js",
	"exports": {
		".": "./dist/index.js"
	},
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"author": "kasahala",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"tsc": "tsc -noEmit",
		"tsc:watch": "tsc -noEmit --watch",
		"dev": "vite",
		"build": "tsdown",
		"test": "vitest",
		"coverage": "vitest run --coverage",
		"lint": "biome lint --write",
		"format": "biome format --write && remark . --output",
		"check": "biome check --write",
		"ci": "biome ci",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@vitest/coverage-v8": "^4.1.10",
		"husky": "^9.1.7",
		"remark": "^15.0.1",
		"remark-cli": "^12.0.1",
		"remark-preset-lint-recommended": "^7.0.1",
		"tsdown": "^0.15.12",
		"typescript": "^5.9.3",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"mdast-util-from-markdown": "^2.0.3",
		"ts-dedent": "^2.3.0"
	},
	"repository": {
		"type": "git",
		"url": "git@github.com:k4a-l/dirtreeist.git"
	}
