{
	"name": "@k4a_l/dirtreeist",
	"version": "0.4.0",
	"main": "dist/index.js",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./": "./"
	},
	"types": "dist/index.d.ts",
	"author": "kasahala",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"tsc": "tsc -noEmit",
		"tsc:watch": "tsc -noEmit --watch",
		"dev": "vite",
		"clean": "rm -rf ./dist/ ",
		"build:esm": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
		"build:cjs": "rollup -c rollup.config.js",
		"build": "npm run clean && npm run build:esm && npm run build:cjs",
		"test": "vitest",
		"coverage": "vitest run --coverage",
		"lint": "biome lint --write",
		"format": "biome format --write && remark . --output",
		"check": "biome check --write",
		"ci": "biome ci",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@rollup/plugin-commonjs": "^22.0.2",
		"@rollup/plugin-node-resolve": "^14.0.1",
		"@rollup/plugin-typescript": "^8.5.0",
		"husky": "^9.1.7",
		"remark": "^15.0.1",
		"remark-cli": "^12.0.1",
		"remark-preset-lint-recommended": "^7.0.1",
		"rollup": "^2.79.0",
		"tsc-alias": "^1.7.0",
		"typescript": "^4.8.2",
		"vite-tsconfig-paths": "^3.5.0",
		"vitest": "^0.23.1"
	},
	"dependencies": {
		"mdast-util-from-markdown": "^1.2.0",
		"ts-dedent": "^2.2.0"
	},
	"repository": {
		"type": "git",
		"url": "git@github.com:k4a-l/dirtreeist.git"
	}
}
